APP_NAME=Aisa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Timestamps are stored in UTC and shown in this timezone.
AISA_DISPLAY_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aisa
DB_USERNAME=root
DB_PASSWORD=

# Sessions are encrypted and HTTP-only. Set SESSION_SECURE_COOKIE=true behind HTTPS.
SESSION_DRIVER=aisa-database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail is used for admin password resets, safety alerts, and account email
# confirmation and password resets. With "log", emails (and their links) are
# written to storage/logs/laravel.log instead of being sent.
# Keep MAIL_FROM_NAME neutral: someone else may see the person's inbox.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Optional "Continue with Google" for public accounts. Leave empty to hide it.
# Create an OAuth client (type: Web application) in Google Cloud Console and add
# the redirect URI below as an authorised redirect URI, exactly as written.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/account/google/callback"

# ---------------------------------------------------------------------------
# Aisa
# ---------------------------------------------------------------------------

# AI provider: "anthropic" (real model) or "mock" (development only, clearly
# labelled in the UI and refused when APP_ENV=production).
AISA_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AISA_AI_MODEL=claude-opus-5-5
AISA_AI_EFFORT=medium
AISA_AI_TIMEOUT=45
AISA_AI_MAX_RETRIES=1
# Server-side refusal fallback (Anthropic beta). Set false to disable.
AISA_AI_REFUSAL_FALLBACK=true
# Hard cap on AI requests per day across the whole site (cost control).
AISA_AI_DAILY_REQUEST_CAP=2000

# Name of the AI assistant shown to users. Must differ from "Aisa".
# Open decision (project document section 17): confirm before launch.
AISA_ASSISTANT_NAME=Msaidizi

# Set to true once a qualified counsellor or health worker has reviewed the
# educational articles (lang/*/articles.php). Until then each article says it is a draft.
AISA_ARTICLES_REVIEWED=false

# Secret used to hash ticket codes. Generate with: php artisan aisa:pepper
# Changing it makes every existing ticket code invalid.
AISA_TICKET_PEPPER=

# Published response window for "Talk to Aisa", in hours.
AISA_RESPONSE_WINDOW_HOURS=48

# Days of inactivity after which conversations are deleted automatically.
AISA_RETENTION_DAYS=180

# Under-18 policy: "restrict" (allowed, prioritised, safer AI), "block"
# (shown resources, cannot start), or "support". Needs legal approval.
AISA_MINOR_POLICY=restrict

# Comma-separated addresses that receive safety alerts.
AISA_SAFETY_ALERT_EMAILS=

# Where Quick exit sends people. Pick something neutral and fast.
AISA_QUICK_EXIT_URL=https://www.google.com/search?q=weather
# Whether Quick exit also forgets a remembered device code.
AISA_QUICK_EXIT_FORGETS_DEVICE=true

# Admin idle timeout in minutes.
AISA_ADMIN_IDLE_MINUTES=30
